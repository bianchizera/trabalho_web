@model OrcamentoMaterial
@{ ViewData["Title"] = "Adicionar material ao orçamento"; }

<div class="page-title"><i class="material-icons left">add</i>Adicionar material ao orçamento #@ViewData["OrcamentoId"]</div>
<div class="card-versatto">
    <form asp-action="AdicionarMaterial" method="post">
        <div asp-validation-summary="ModelOnly" class="alerta-erro"></div>
        <input type="hidden" asp-for="OrcamentoId" />
        <div class="row">
            <div class="input-field col s12 m6">
                <label asp-for="MaterialId">Material *</label><br>
                <select asp-for="MaterialId" asp-items="ViewBag.MaterialId"></select>
                <span asp-validation-for="MaterialId" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m3">
                <i class="material-icons prefix">numbers</i>
                <input asp-for="QuantidadeEstimada" type="number" step="0.01" />
                <label asp-for="QuantidadeEstimada">Qtd. estimada *</label>
                <span asp-validation-for="QuantidadeEstimada" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m3">
                <i class="material-icons prefix">attach_money</i>
                <input asp-for="ValorUnitario" type="number" step="0.01" />
                <label asp-for="ValorUnitario">Valor unitário *</label>
                <span asp-validation-for="ValorUnitario" class="helper-text"></span>
            </div>
        </div>
        <div class="row">
            <div class="col s12">
                <button class="btn btn-versatto waves-effect" type="submit"><i class="material-icons left">add</i>Adicionar</button>
                <a asp-action="Details" asp-route-id="@Model.OrcamentoId" class="btn grey waves-effect" style="margin-left:8px">Cancelar</a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
