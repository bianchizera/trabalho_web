@model Orcamento
@{ ViewData["Title"] = "Novo orçamento"; }

<div class="page-title"><i class="material-icons left">add</i>Novo Orçamento</div>
<div class="card-versatto">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alerta-erro"></div>
        <div class="row">
            <div class="input-field col s12 m6">
                <label asp-for="ClienteId">Cliente *</label><br>
                <select asp-for="ClienteId" asp-items="ViewBag.ClienteId"></select>
                <span asp-validation-for="ClienteId" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m3">
                <i class="material-icons prefix">tag</i>
                <input asp-for="Versao" type="number" />
                <label asp-for="Versao">Versão</label>
                <span asp-validation-for="Versao" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m3">
                <i class="material-icons prefix">event</i>
                <input asp-for="DataOrcamento" type="date" />
                <label asp-for="DataOrcamento" class="active">Data</label>
                <span asp-validation-for="DataOrcamento" class="helper-text"></span>
            </div>
        </div>
        <div class="row">
            <div class="input-field col s12 m6">
                <i class="material-icons prefix">engineering</i>
                <input asp-for="ValorMaoObra" type="number" step="0.01" />
                <label asp-for="ValorMaoObra">Valor mão de obra</label>
                <span asp-validation-for="ValorMaoObra" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m6">
                <label asp-for="Status">Status</label><br>
                <select asp-for="Status" asp-items="ViewBag.Status"></select>
                <span asp-validation-for="Status" class="helper-text"></span>
            </div>
        </div>
        <p><em>O valor de materiais é calculado automaticamente ao adicionar itens depois de salvar.</em></p>
        <div class="row">
            <div class="col s12">
                <button class="btn btn-versatto waves-effect" type="submit"><i class="material-icons left">save</i>Salvar</button>
                <a asp-action="Index" class="btn grey waves-effect" style="margin-left:8px"><i class="material-icons left">arrow_back</i>Voltar</a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
