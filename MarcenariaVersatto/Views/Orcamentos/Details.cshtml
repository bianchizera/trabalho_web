@model Orcamento
@{ ViewData["Title"] = "Detalhes do orçamento"; }

<div class="page-title"><i class="material-icons left">request_quote</i>Orçamento #@Model.Id — @Model.Cliente?.Nome</div>

<div class="card-versatto">
    <div class="row" style="margin-bottom:0">
        <div class="col s12 m3"><strong>Versão:</strong> @Model.Versao</div>
        <div class="col s12 m3"><strong>Data:</strong> @Model.DataOrcamento.ToShortDateString()</div>
        <div class="col s12 m3"><strong>Status:</strong> @Model.Status</div>
        <div class="col s12 m3"><strong>Materiais:</strong> @Model.ValorMateriais.ToString("C2")</div>
        <div class="col s12 m6"><strong>Mão de obra:</strong> @Model.ValorMaoObra.ToString("C2")</div>
        <div class="col s12 m6"><div class="total-box">Total: @Model.ValorTotal.ToString("C2")</div></div>
    </div>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-versatto waves-effect"><i class="material-icons left">edit</i>Editar orçamento</a>
</div>

<div class="page-title" style="margin-top:24px"><i class="material-icons left">inventory_2</i>Materiais do orçamento</div>
<div class="card-versatto">
    <a asp-action="AdicionarMaterial" asp-route-orcamentoId="@Model.Id" class="btn btn-amarelo waves-effect"><i class="material-icons left">add</i>Adicionar material</a>
</div>
<div class="card-versatto" style="padding:0;overflow-x:auto">
    <table class="versatto-table responsive-table" id="tabela-itens">
        <thead><tr><th>Material</th><th>Qtd. estimada</th><th>Valor unitário</th><th>Subtotal</th><th class="center">Ações</th></tr></thead>
        <tbody>
@if (!Model.Materiais.Any())
{
            <tr><td colspan="5" class="center grey-text">Nenhum material adicionado.</td></tr>
}
else
{
    foreach (var item in Model.Materiais)
    {
            <tr>
                <td>@item.Material?.Nome</td>
                <td>@item.QuantidadeEstimada</td>
                <td>@item.ValorUnitario.ToString("C2")</td>
                <td>@item.ValorTotal.ToString("C2")</td>
                <td class="center">
                    <form asp-action="RemoverMaterial" method="post" style="display:inline">
                        <input type="hidden" name="id" value="@item.Id" />
                        <input type="hidden" name="orcamentoId" value="@Model.Id" />
                        <button type="submit" class="btn-floating btn-small red tooltipped" data-tooltip="Remover"><i class="material-icons">delete</i></button>
                    </form>
                </td>
            </tr>
    }
}
        </tbody>
    </table>
</div>

<div class="page-title" style="margin-top:24px"><i class="material-icons left">payments</i>Pagamentos</div>
<div class="card-versatto">
    <a asp-controller="Pagamentos" asp-action="Create" asp-route-orcamentoId="@Model.Id" class="btn btn-amarelo waves-effect"><i class="material-icons left">add</i>Registrar pagamento</a>
</div>
<div class="card-versatto" style="padding:0;overflow-x:auto">
    <table class="versatto-table responsive-table">
        <thead><tr><th>Valor</th><th>Forma</th><th>Data</th><th>Status</th></tr></thead>
        <tbody>
@if (!Model.Pagamentos.Any())
{
            <tr><td colspan="4" class="center grey-text">Nenhum pagamento registrado.</td></tr>
}
else
{
    foreach (var pg in Model.Pagamentos)
    {
            <tr>
                <td>@pg.Valor.ToString("C2")</td>
                <td>@pg.FormaPagamento</td>
                <td>@(pg.DataPagamento?.ToShortDateString() ?? "-")</td>
                <td>@pg.Status</td>
            </tr>
    }
}
        </tbody>
    </table>
</div>

<a asp-action="Index" class="btn grey waves-effect" style="margin-top:12px"><i class="material-icons left">arrow_back</i>Voltar à lista</a>
