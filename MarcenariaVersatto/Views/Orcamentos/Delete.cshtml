@model Orcamento
@{ ViewData["Title"] = "Excluir orçamento"; }

<div class="page-title"><i class="material-icons left">delete</i>Excluir Orçamento</div>
<div class="card-versatto">
    <p>Confirma a exclusão do orçamento #@Model.Id de <strong>@Model.Cliente?.Nome</strong>?</p>
    <div class="alerta-erro">Os materiais e pagamentos vinculados também serão excluídos.</div>
    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn red waves-effect"><i class="material-icons left">delete</i>Confirmar exclusão</button>
        <a asp-action="Index" class="btn grey waves-effect" style="margin-left:8px">Cancelar</a>
    </form>
</div>
