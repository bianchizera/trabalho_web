@model MarcenariaVersatto.ViewModels.UsuarioCreateViewModel
@{ ViewData["Title"] = "Novo usuário"; }

<div class="page-title"><i class="material-icons left">person_add</i>Novo Usuário</div>
<div class="card-versatto">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alerta-erro"></div>
        <div class="row">
            <div class="input-field col s12 m6">
                <label asp-for="FuncionarioId">Funcionário *</label><br>
                <select asp-for="FuncionarioId" asp-items="ViewBag.FuncionarioId"></select>
                <span asp-validation-for="FuncionarioId" class="helper-text"></span>
                <span class="helper-text">Só aparecem funcionários ativos que ainda não têm usuário.</span>
            </div>
            <div class="input-field col s12 m6">
                <label asp-for="Perfil">Perfil de acesso *</label><br>
                <select asp-for="Perfil" asp-items="ViewBag.Perfil"></select>
                <span asp-validation-for="Perfil" class="helper-text"></span>
            </div>
        </div>
        <div class="row">
            <div class="input-field col s12 m4">
                <i class="material-icons prefix">account_circle</i>
                <input asp-for="Login" maxlength="50" autocomplete="off" />
                <label asp-for="Login">Login *</label>
                <span asp-validation-for="Login" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m4">
                <i class="material-icons prefix">lock</i>
                <input asp-for="Senha" type="password" autocomplete="new-password" />
                <label asp-for="Senha">Senha *</label>
                <span asp-validation-for="Senha" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m4">
                <i class="material-icons prefix">lock_outline</i>
                <input asp-for="ConfirmarSenha" type="password" autocomplete="new-password" />
                <label asp-for="ConfirmarSenha">Confirmar senha *</label>
                <span asp-validation-for="ConfirmarSenha" class="helper-text"></span>
            </div>
        </div>
        <div class="row">
            <div class="col s12">
                <button class="btn btn-versatto waves-effect" type="submit"><i class="material-icons left">save</i>Salvar</button>
                <a asp-action="Index" class="btn grey waves-effect" style="margin-left:8px"><i class="material-icons left">arrow_back</i>Voltar</a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
