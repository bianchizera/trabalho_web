@model IEnumerable<Funcionario>
@{ ViewData["Title"] = "Funcionários"; }

<div class="page-title"><i class="material-icons left">badge</i>Funcionários</div>

<div class="card-versatto">
    <form method="get" asp-action="Index">
        <div class="row filtro-row" style="margin-bottom:0">
            <div class="input-field col s12 m4">
                <i class="material-icons prefix">search</i>
                <input type="text" id="nome" name="nome" value="@ViewBag.f_nome" />
                <label for="nome">Nome</label>
            </div>
            <div class="input-field col s12 m3">
                <label for="cargo">Cargo</label><br>
                <select id="cargo" name="cargo" asp-items="ViewBag.f_cargo"><option value="">Todos</option></select>
            </div>
            <div class="input-field col s12 m2">
                <label for="ativo">Ativo</label><br>
                <select id="ativo" name="ativo" asp-items="ViewBag.f_ativo"><option value="">Todos</option></select>
            </div>
            <partial name="_FiltroAcoes" />
        </div>
    </form>
    @if (User.IsInRole(Perfis.Admin))
    {
        <div class="row valign-wrapper" style="margin-bottom:0"><div class="col s12 right-align">
            <a asp-action="Create" class="btn btn-amarelo waves-effect"><i class="material-icons left">add</i>Novo Funcionário</a>
        </div></div>
    }
</div>

<div class="card-versatto" style="padding:0;overflow-x:auto">
    <table class="versatto-table responsive-table">
        <thead><tr><th>#</th><th>Nome</th><th>Cargo</th><th>Telefone</th><th>Admissão</th><th>Ativo</th><th class="center">Ações</th></tr></thead>
        <tbody>
@if (!Model.Any())
{
            <tr><td colspan="7" class="center grey-text">Nenhum funcionário encontrado.</td></tr>
}
else
{
    foreach (var item in Model)
    {
            <tr>
                <td>@item.Id</td>
                <td>@item.Nome</td>
                <td>@item.Cargo</td>
                <td>@item.Telefone</td>
                <td>@item.DataAdmissao.ToShortDateString()</td>
                <td>@(item.Ativo ? "Sim" : "Não")</td>
                <td class="center" style="white-space:nowrap">
                    <a class="btn-floating btn-small waves-effect blue tooltipped" data-tooltip="Detalhes" asp-action="Details" asp-route-id="@item.Id"><i class="material-icons">info</i></a>
                    @if (User.IsInRole(Perfis.Admin)) { <a class="btn-floating btn-small waves-effect orange tooltipped" data-tooltip="Editar" asp-action="Edit" asp-route-id="@item.Id"><i class="material-icons">edit</i></a> }
                    @if (User.IsInRole(Perfis.Admin)) { <a class="btn-floating btn-small waves-effect red tooltipped" data-tooltip="Excluir" asp-action="Delete" asp-route-id="@item.Id"><i class="material-icons">delete</i></a> }
                </td>
            </tr>
    }
}
        </tbody>
    </table>
</div>
