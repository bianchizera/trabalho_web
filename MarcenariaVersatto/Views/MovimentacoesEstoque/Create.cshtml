@model MovimentacaoEstoque
@{
    var entrada = Model.Tipo != "saida";
    ViewData["Title"] = entrada ? "Registrar entrada" : "Registrar saída";
}

<div class="page-title"><i class="material-icons left">@(entrada ? "south_west" : "north_east")</i>@(entrada ? "Registrar Entrada de Estoque" : "Registrar Saída de Estoque")</div>
<div class="card-versatto">
    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="alerta-erro"></div>
        <div class="row">
            <div class="input-field col s12 m6">
                <label asp-for="MaterialId">Material *</label><br>
                <select asp-for="MaterialId" asp-items="ViewBag.MaterialId"></select>
                <span asp-validation-for="MaterialId" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m6">
                <label asp-for="Tipo">Tipo *</label><br>
                <select asp-for="Tipo" asp-items="ViewBag.Tipo"></select>
                <span asp-validation-for="Tipo" class="helper-text"></span>
            </div>
        </div>
        <div class="row">
            <div class="input-field col s12 m4">
                <i class="material-icons prefix">numbers</i>
                <input asp-for="Quantidade" type="number" step="0.01" min="0.01" />
                <label asp-for="Quantidade">Quantidade *</label>
                <span asp-validation-for="Quantidade" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m4">
                <label asp-for="FornecedorId">Fornecedor (somente entradas)</label><br>
                <select asp-for="FornecedorId" asp-items="ViewBag.FornecedorId">
                    <option value="">-- nenhum --</option>
                </select>
                <span asp-validation-for="FornecedorId" class="helper-text"></span>
            </div>
            <div class="input-field col s12 m4">
                @if (User.IsInRole(Perfis.Admin))
                {
                    <label asp-for="FuncionarioId">Funcionário *</label><br>
                    <select asp-for="FuncionarioId" asp-items="ViewBag.FuncionarioId"></select>
                    <span asp-validation-for="FuncionarioId" class="helper-text"></span>
                }
                else
                {
                    <input type="hidden" asp-for="FuncionarioId" />
                    <p style="margin-top:20px"><strong>Responsável:</strong> @ViewBag.NomeFuncionario</p>
                }
            </div>
        </div>
        <div class="row">
            <div class="input-field col s12">
                <i class="material-icons prefix">notes</i>
                <input asp-for="Motivo" maxlength="255" />
                <label asp-for="Motivo">Motivo</label>
                <span asp-validation-for="Motivo" class="helper-text"></span>
            </div>
        </div>
        <div class="row">
            <div class="col s12">
                <button class="btn btn-versatto waves-effect" type="submit"><i class="material-icons left">save</i>Registrar</button>
                <a asp-action="Index" class="btn grey waves-effect" style="margin-left:8px"><i class="material-icons left">arrow_back</i>Voltar</a>
            </div>
        </div>
    </form>
</div>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
