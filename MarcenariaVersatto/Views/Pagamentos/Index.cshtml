@model IEnumerable<Pagamento>
@{ ViewData["Title"] = "Pagamentos"; }

<div class="page-title"><i class="material-icons left">payments</i>Pagamentos</div>
<div class="card-versatto">
    <form method="get" asp-action="Index">
        <div class="row filtro-row" style="margin-bottom:0">
            <div class="input-field col s12 m3">
                <i class="material-icons prefix">search</i>
                <input type="text" id="cliente" name="cliente" value="@ViewBag.f_cliente" />
                <label for="cliente">Cliente</label>
            </div>
            <div class="input-field col s12 m2">
                <label for="status">Status</label><br>
                <select id="status" name="status" asp-items="ViewBag.f_status"><option value="">Todos</option></select>
            </div>
            <div class="input-field col s12 m2">
                <label for="forma">Forma</label><br>
                <select id="forma" name="forma" asp-items="ViewBag.f_forma"><option value="">Todas</option></select>
            </div>
            <div class="input-field col s12 m2">
                <input type="date" id="de" name="de" value="@ViewBag.f_de" />
                <label for="de" class="active">De</label>
            </div>
            <div class="input-field col s12 m2">
                <input type="date" id="ate" name="ate" value="@ViewBag.f_ate" />
                <label for="ate" class="active">Até</label>
            </div>
            <div class="col s12 filtro-acoes linha">
                <button type="submit" class="btn btn-versatto waves-effect"><i class="material-icons left">search</i>Filtrar</button>
                <a asp-action="Index" class="btn grey waves-effect" style="margin-left:8px">Limpar</a>
            </div>
        </div>
    </form>
    <div class="row valign-wrapper" style="margin-bottom:0"><div class="col s12 right-align">
        <a asp-action="Create" class="btn btn-amarelo waves-effect"><i class="material-icons left">add</i>Novo Pagamento</a>
    </div></div>
</div>

<div class="card-versatto" style="padding:0;overflow-x:auto">
    <table class="versatto-table responsive-table">
        <thead><tr><th>Orçamento</th><th>Cliente</th><th>Valor</th><th>Forma</th><th>Data</th><th>Status</th><th class="center">Ações</th></tr></thead>
        <tbody>
@if (!Model.Any())
{
            <tr><td colspan="7" class="center grey-text">Nenhum pagamento encontrado.</td></tr>
}
else
{
    foreach (var item in Model)
    {
            <tr>
                <td>#@item.OrcamentoId</td>
                <td>@item.Orcamento?.Cliente?.Nome</td>
                <td>@item.Valor.ToString("C2")</td>
                <td>@item.FormaPagamento</td>
                <td>@(item.DataPagamento?.ToShortDateString() ?? "-")</td>
                <td>@item.Status</td>
                <td class="center" style="white-space:nowrap">
                    <a class="btn-floating btn-small waves-effect blue tooltipped" data-tooltip="Detalhes" asp-action="Details" asp-route-id="@item.Id"><i class="material-icons">info</i></a>
                    <a class="btn-floating btn-small waves-effect orange tooltipped" data-tooltip="Editar" asp-action="Edit" asp-route-id="@item.Id"><i class="material-icons">edit</i></a>
                    <a class="btn-floating btn-small waves-effect red tooltipped" data-tooltip="Excluir" asp-action="Delete" asp-route-id="@item.Id"><i class="material-icons">delete</i></a>
                </td>
            </tr>
    }
}
        </tbody>
    </table>
</div>
