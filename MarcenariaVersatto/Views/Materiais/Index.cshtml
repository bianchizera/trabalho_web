@model IEnumerable<Material>
@{ ViewData["Title"] = "Materiais"; }

<div class="page-title"><i class="material-icons left">inventory_2</i>Materiais</div>
<div class="card-versatto">
    <form method="get" asp-action="Index">
        <div class="row filtro-row" style="margin-bottom:0">
            <div class="input-field col s12 m4">
                <i class="material-icons prefix">search</i>
                <input type="text" id="nome" name="nome" value="@ViewBag.f_nome" />
                <label for="nome">Nome do material</label>
            </div>
            <div class="input-field col s12 m3">
                <label for="categoriaId">Categoria</label><br>
                <select id="categoriaId" name="categoriaId" asp-items="ViewBag.f_categoria"><option value="">Todas</option></select>
            </div>
            <div class="input-field col s12 m2">
                <label for="situacao">Situação</label><br>
                <select id="situacao" name="situacao" asp-items="ViewBag.f_situacao"><option value="">Todas</option></select>
            </div>
            <partial name="_FiltroAcoes" />
        </div>
    </form>
    @if (User.IsInRole(Perfis.Admin))
    {
        <div class="row valign-wrapper" style="margin-bottom:0"><div class="col s12 right-align">
            <a asp-action="Create" class="btn btn-amarelo waves-effect"><i class="material-icons left">add</i>Novo Material</a>
        </div></div>
    }
</div>

<div class="card-versatto" style="padding:0;overflow-x:auto">
    <table class="versatto-table responsive-table">
        <thead>
            <tr><th>#</th><th>Nome</th><th>Categoria</th><th>Unidade</th><th>Estoque atual</th><th>Estoque mínimo</th><th>Valor unitário</th><th class="center">Ações</th></tr>
        </thead>
        <tbody>
@if (!Model.Any())
{
            <tr><td colspan="8" class="center grey-text">Nenhum material encontrado.</td></tr>
}
else
{
    foreach (var item in Model)
    {
        var abaixo = item.EstoqueAtual < item.EstoqueMinimo;
            <tr class="@(abaixo ? "estoque-baixo" : "")">
                <td>@item.Id</td>
                <td>@item.Nome</td>
                <td>@item.Categoria?.Nome</td>
                <td>@item.UnidadeMedida</td>
                <td>@item.EstoqueAtual @(abaixo ? "⚠" : "")</td>
                <td>@item.EstoqueMinimo</td>
                <td>@item.ValorUnitario.ToString("C2")</td>
                <td class="center" style="white-space:nowrap">
                    <a class="btn-floating btn-small waves-effect blue tooltipped" data-tooltip="Detalhes" asp-action="Details" asp-route-id="@item.Id"><i class="material-icons">info</i></a>
                    @if (User.IsInRole(Perfis.Admin)) { <a class="btn-floating btn-small waves-effect orange tooltipped" data-tooltip="Editar" asp-action="Edit" asp-route-id="@item.Id"><i class="material-icons">edit</i></a> }
                    @if (User.IsInRole(Perfis.Admin)) { <a class="btn-floating btn-small waves-effect red tooltipped" data-tooltip="Excluir" asp-action="Delete" asp-route-id="@item.Id"><i class="material-icons">delete</i></a> }
                </td>
            </tr>
    }
}
        </tbody>
    </table>
</div>
