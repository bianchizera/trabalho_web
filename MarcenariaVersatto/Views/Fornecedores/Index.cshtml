@model IEnumerable<Fornecedor>
@{ ViewData["Title"] = "Fornecedores"; }

<div class="page-title"><i class="material-icons left">business</i>Fornecedores</div>
<div class="card-versatto">
    <form method="get" asp-action="Index">
        <div class="row filtro-row" style="margin-bottom:0">
            <div class="input-field col s12 m6">
                <i class="material-icons prefix">search</i>
                <input type="text" id="busca" name="busca" value="@ViewBag.f_busca" />
                <label for="busca">Razão social, CNPJ ou e-mail</label>
            </div>
            <partial name="_FiltroAcoes" />
        </div>
    </form>
    @if (User.IsInRole(Perfis.Admin))
    {
        <div class="row valign-wrapper" style="margin-bottom:0"><div class="col s12 right-align">
            <a asp-action="Create" class="btn btn-amarelo waves-effect"><i class="material-icons left">add</i>Novo Fornecedor</a>
        </div></div>
    }
</div>

<div class="card-versatto" style="padding:0;overflow-x:auto">
    <table class="versatto-table responsive-table">
        <thead><tr><th>#</th><th>Razão social</th><th>CNPJ</th><th>Telefone</th><th>E-mail</th><th class="center">Ações</th></tr></thead>
        <tbody>
@if (!Model.Any())
{
            <tr><td colspan="6" class="center grey-text">Nenhum fornecedor encontrado.</td></tr>
}
else
{
    foreach (var item in Model)
    {
            <tr>
                <td>@item.Id</td>
                <td>@item.RazaoSocial</td>
                <td>@item.Cnpj</td>
                <td>@item.Telefone</td>
                <td>@item.Email</td>
                <td class="center" style="white-space:nowrap">
                    <a class="btn-floating btn-small waves-effect blue tooltipped" data-tooltip="Detalhes" asp-action="Details" asp-route-id="@item.Id"><i class="material-icons">info</i></a>
                    @if (User.IsInRole(Perfis.Admin)) { <a class="btn-floating btn-small waves-effect orange tooltipped" data-tooltip="Editar" asp-action="Edit" asp-route-id="@item.Id"><i class="material-icons">edit</i></a> }
                    @if (User.IsInRole(Perfis.Admin)) { <a class="btn-floating btn-small waves-effect red tooltipped" data-tooltip="Excluir" asp-action="Delete" asp-route-id="@item.Id"><i class="material-icons">delete</i></a> }
                </td>
            </tr>
    }
}
        </tbody>
    </table>
</div>
